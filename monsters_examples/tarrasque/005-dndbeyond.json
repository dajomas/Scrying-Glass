d","class":"modifier","text":"+0"},{"element":"td","class":"modifier","text":"+9"},{"element":"th","class":"","text":"CHA"},{"element":"td","class":"","text":"11"},{"element":"td","class":"modifier","text":"+0"},{"element":"td","class":"modifier","text":"+9"},{"element":"span","class":"mon-stat-block-2024__tidbit-label","text":"Skills"},{"element":"a","class":"tooltip-hover skill-tooltip","text":"Perception"},{"element":"span","class":"mon-stat-block-2024__tidbit-data","text":"+9"},{"element":"span","class":"mon-stat-block-2024__tidbit-label","text":"Resistances"},{"element":"span","class":"mon-stat-block-2024__tidbit-data","text":"Bludgeoning, Piercing, Slashing"},{"element":"span","class":"mon-stat-block-2024__tidbit-label","text":"Immunities"},{"element":"span","class":"mon-stat-block-2024__tidbit-data","text":"Fire, Poison;"},{"element":"a","class":"tooltip-hover condition-tooltip","text":"Charmed"},{"element":"span","class":"mon-stat-block-2024__tidbit-data","text":","},{"element":"a","class":"tooltip-hover condition-tooltip","text":"Deafened"},{"element":"span","class":"mon-stat-block-2024__tidbit-data","text":","},{"element":"a","class":"tooltip-hover condition-tooltip","text":"Frightened"},{"element":"span","class":"mon-stat-block-2024__tidbit-data","text":","},{"element":"a","class":"tooltip-hover condition-tooltip","text":"Paralyzed"},{"element":"span","class":"mon-stat-block-2024__tidbit-data","text":","},{"element":"a","class":"tooltip-hover condition-tooltip","text":"Poisoned"},{"element":"span","class":"mon-stat-block-2024__tidbit-label","text":"Senses"},{"element":"a","class":"tooltip-hover sense-tooltip","text":"Blindsight"},{"element":"span","class":"mon-stat-block-2024__tidbit-data","text":"120 ft.;  Passive Perception 19"},{"element":"span","class":"mon-stat-block-2024__tidbit-label","text":"Languages"},{"element":"span","class":"mon-stat-block-2024__tidbit-data","text":"None"},{"element":"span","class":"mon-stat-block-2024__tidbit-label","text":"CR"},{"element":"span","class":"mon-stat-block-2024__tidbit-data","text":"30 (XP 155,000; PB +9)"},{"element":"div","class":"mon-stat-block-2024__description-block-heading","text":"Traits"},{"element":"strong","class":"","text":"Legendary Resistance (6/Day)."},{"element":"p","class":"","text":"If the tarrasque fails a saving throw, it can choose to succeed instead."},{"element":"strong","class":"","text":"Magic Resistance."},{"element":"p","class":"","text":"The tarrasque has"},{"element":"a","class":"tooltip-hover rule-tooltip","text":"Advantage"},{"element":"p","class":"","text":"on saving throws against spells and other magical effects."},{"element":"strong","class":"","text":"Reflective Carapace."},{"element":"p","class":"","text":"If the tarrasque is targeted by a"},{"element":"a","class":"tooltip-hover spell-tooltip","text":"Magic Missile"},{"element":"p","class":"","text":"spell or a spell that requires a ranged attack roll, roll"},{"element":"span","class":"","text":"1d6"},{"element":"p","class":"","text":". On a 1–5, the tarrasque is unaffected. On a 6, the tarrasque is unaffected and reflects the spell, turning the caster into the target."},{"element":"strong","class":"","text":"Siege Monster."},{"element":"p","class":"","text":"The tarrasque deals double damage to objects and structures."},{"element":"div","class":"mon-stat-block-2024__description-block-heading","text":"Actions"},{"element":"strong","class":"","text":"Multiattack."},{"element":"p","class":"","text":"The tarrasque makes one Bite attack and three other attacks, using Claw or Tail in any combination."},{"element":"strong","class":"","text":"Bite."},{"element":"em","class":"","text":"Melee Attack Roll:"},{"element":"span","class":"","text":"+19"},{"element":"p","class":"","text":", reach 15 ft."},{"element":"em","class":"","text":"Hit:"},{"element":"p","class":"","text":"36"},{"element":"span","class":"","text":"(4d12 + 10)"},{"element":"p","class":"","text":"Piercing damage, and the target has the"},{"element":"a","class":"tooltip-hover condition-tooltip","text":"Grappled"},{"element":"p","class":"","text":"condition (escape DC 20). Until the grapple ends, the target has the"},{"element":"a","class":"tooltip-hover condition-tooltip","text":"Restrained"},{"element":"p","class":"","text":"condition and can’t teleport."},{"element":"strong","class":"","text":"Claw."},{"element":"em","class":"","text":"Melee Attack Roll:"},{"element":"span","class":"","text":"+19"},{"element":"p","class":"","text":", reach 15 ft."},{"element":"em","class":"","text":"Hit:"},{"element":"p","class":"","text":"28"},{"element":"span","class":"","text":"(4d8 + 10)"},{"element":"p","class":"","text":"Slashing damage."},{"element":"strong","class":"","text":"Tail."},{"element":"em","class":"","text":"Melee Attack Roll:"},{"element":"span","class":"","text":"+19"},{"element":"p","class":"","text":", reach 30 ft."},{"element":"em","class":"","text":"Hit:"},{"element":"p","class":"","text":"23"},{"element":"span","class":"","text":"(3d8 + 10)"},{"element":"p","class":"","text":"Bludgeoning damage. If the target is a Huge or smaller creature, it has the"},{"element":"a","class":"tooltip-hover condition-tooltip","text":"Prone"},{"element":"p","class":"","text":"condition."},{"element":"strong","class":"","text":"Thunderous Bellow"},{"element":"span","class":"","text":"(Recharge 5–6)"},{"element":"strong","class":"","text":"."},{"element":"em","class":"","text":"Constitution Saving Throw:"},{"element":"p","class":"","text":"DC 27, each creature and each object that isn’t being worn or carried in a 150-foot Cone."},{"element":"em","class":"","text":"Failure:"},{"element":"p","class":"","text":"78"},{"element":"span","class":"","text":"(12d12)"},{"element":"p","class":"","text":"Thunder damage, and the target has the"},{"element":"a","class":"tooltip-hover condition-tooltip","text":"Deafened"},{"element":"p","class":"","text":"and"},{"element":"a","class":"tooltip-hover condition-tooltip","text":"Frightened"},{"element":"p","class":"","text":"conditions until the end of its next turn."},{"element":"em","class":"","text":"Success:"},{"element":"p","class":"","text":"Half damage only."},{"element":"div","class":"mon-stat-block-2024__description-block-heading","text":"Bonus Actions"},{"element":"strong","class":"","text":"Swallow."},{"element":"em","class":"","text":"Strength Saving Throw:"},{"element":"p","class":"","text":"DC 27, one Large or smaller creature"},{"element":"a","class":"tooltip-hover condition-tooltip","text":"Grappled"},{"element":"p","class":"","text":"by the tarrasque (it can have up to six creatures swallowed at a time)."},{"element":"em","class":"","text":"Failure:"},{"element":"p","class":"","text":"The target is swallowed, and the Grappled condition ends. A swallowed creature has the"},{"element":"a","class":"tooltip-hover condition-tooltip","text":"Blinded"},{"element":"p","class":"","text":"and"},{"element":"a","class":"tooltip-hover condition-tooltip","text":"Restrained"},{"element":"p","class":"","text":"conditions and can’t teleport, it has"},{"element":"a","class":"tooltip-hover rule-tooltip","text":"Total Cover"},{"element":"p","class":"","text":"against attacks and other effects outside the tarrasque, and it takes 56"},{"element":"span","class":"","text":"(16d6)"},{"element":"p","class":"","text":"Acid damage at the start of each of the tarrasque’s turns."},{"element":"p","class":"","text":"If the tarrasque takes 60 damage or more on a single turn from a creature inside it, the tarrasque must succeed on a DC 20 Constitution saving throw at the end of that turn or regurgitate all swallowed creatures, each of which falls in a space within 10 feet of the tarrasque and has the"},{"element":"a","class":"tooltip-hover condition-tooltip","text":"Prone"},{"element":"p","class":"","text":"condition. If the tarrasque dies, any swallowed creature no longer has the"},{"element":"a","class":"tooltip-hover condition-tooltip","text":"Restrained"},{"element":"p","class":"","text":"condition and can escape from the corpse using 20 feet of movement, exiting Prone."},{"element":"div","class":"mon-stat-block-2024__description-block-heading","text":"Legendary Actions"},{"element":"p","class":"legendary-actions","text":"Legendary Action Uses: 3. Immediately after another creature’s turn, the tarrasque can expend a use to take one of the following actions. The tarrasque regains all expended uses at the start of each of its turns."},{"element":"strong","class":"","text":"Onslaught."},{"element":"p","class":"","text":"The tarrasque moves up to half its Speed, and it makes one Claw or Tail attack."},{"element":"strong","class":"","text":"World-Shaking Movement."},{"element":"p","class":"","text":"The tarrasque moves up to its Speed. At the end of this movement, the tarrasque creates an instantaneous shock wave in a 60-foot Emanation originating from itself. Creatures in that area lose"},{"element":"a","class":"tooltip-hover rule-tooltip","text":"Concentration"},{"element":"p","class":"","text":"and, if Medium or smaller, have the"},{"element":"a","class":"tooltip-hover condition-tooltip","text":"Prone"},{"element":"p","class":"","text":"condition. The tarrasque can’t take this action again until the start of its next turn."}],"tags":179,"max_dom_depth":8}